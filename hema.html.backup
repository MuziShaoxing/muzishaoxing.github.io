<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=yes">
    <title>盒马 · 常用文件</title>
    <meta name="author" content="少星">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="shortcut icon" href="https://mzsx.netlify.app/app/img/favicon.ico">
    <style>
        /* ============================================
           1. 全局重置 · 禁止body滚动
           ============================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(145deg, #f1f5f9 0%, #e4eaf1 100%);
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            height: 100vh;
            overflow: hidden;
            padding: 1.5rem 1rem;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* ============================================
           2. 主卡片 · 固定宽度 · 禁止溢出
           ============================================ */
        .container {
            width: 100%;
            max-width: 520px;
            height: calc(100vh - 3rem);
            max-height: 900px;
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 2rem;
            box-shadow: 0 20px 40px -12px rgba(0, 20, 40, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.5);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* ============================================
           3. 头部 · Logo
           ============================================ */
        .header {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 24px 0 14px;
            flex-shrink: 0;
        }

        .header .ats {
            width: 72px;
            height: 72px;
            border-radius: 18px;
            object-fit: cover;
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.04);
        }

        /* ============================================
           4. 导航栏
           ============================================ */
        .nav-menu {
            padding: 10px 0;
            text-align: center;
            background: rgba(248, 250, 252, 0.4);
            border-bottom: 1px solid rgba(203, 221, 238, 0.4);
            flex-shrink: 0;
        }

        .nav-menu .menu-text {
            font-size: 1rem;
            color: #2c5f7e;
            font-weight: 500;
        }

        .nav-menu i {
            margin-right: 6px;
            color: #3e7b9f;
        }

        /* ============================================
           5. 下拉区域 · 固定不滚动
           ============================================ */
        .dropdown-section {
            padding: 18px 20px 0;
            flex-shrink: 0;
        }

        .dropdown-wrapper {
            position: relative;
            margin-bottom: 16px;
        }

        .dropdown-trigger {
            width: 100%;
            background: #fff;
            border: 1.5px solid #cfdfec;
            border-radius: 1.4rem;
            padding: 0.9rem 1.2rem;
            font-size: 1rem;
            font-weight: 500;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            color: #1f4662;
            transition: all 0.2s;
        }

        .dropdown-trigger:hover {
            background: #fefefe;
            border-color: #9bbad2;
        }

        .trigger-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .trigger-left i, .trigger-left img {
            font-size: 1.3rem;
            color: #2c7eb6;
            width: 1.5rem;
            height: 1.5rem;
            object-fit: contain;
        }

        .arrow-icon {
            font-size: 1.2rem;
            color: #7097b3;
            transition: transform 0.25s;
        }

        .dropdown-wrapper.open .arrow-icon {
            transform: rotate(180deg);
        }

        /* ============================================
           6. 下拉菜单浮层 · 可滚动 · 隐藏滚动条
           ============================================ */
        .dropdown-menu {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            width: 100%;
            max-height: 280px;
            background: #fff;
            border-radius: 1.2rem;
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
            z-index: 100;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: none;
            -ms-overflow-style: none;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: all 0.2s;
            border: 1px solid #e2edf6;
        }

        .dropdown-menu::-webkit-scrollbar {
            display: none;
        }

        .dropdown-wrapper.open .dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .dropdown-menu ul {
            list-style: none;
            padding: 0.4rem 0;
        }

        .dropdown-menu li {
            padding: 0.8rem 1.2rem;
            cursor: pointer;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.8rem;
            color: #1e4d6b;
            transition: background 0.15s;
            word-break: break-word;
            white-space: normal;
        }

        .dropdown-menu li:hover {
            background: #f0f7fe;
        }

        .dropdown-menu li.active {
            background: #e3f0fd;
            color: #1c6b9e;
        }

        .dropdown-menu li i, .dropdown-menu li img {
            width: 22px;
            color: #5882a8;
            flex-shrink: 0;
        }

        .dropdown-menu li img {
            object-fit: contain;
            height: 1.2rem;
        }

        /* ============================================
           7. 内容区 · 仅垂直滚动 · 禁止水平滚动
           ============================================ */
        .content {
            padding: 0 20px 30px;
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        .content::-webkit-scrollbar {
            display: none;
        }

        /* ============================================
           8. 文件列表项 · 自动换行
           ============================================ */
        .file-panel {
            padding-top: 4px;
            width: 100%;
        }

        .file-item {
            display: flex;
            align-items: flex-start;
            padding: 0.9rem 1rem;
            margin-bottom: 8px;
            background: rgba(255, 255, 255, 0.6);
            border-radius: 1.2rem;
            border: 1px solid #eaf1f9;
            transition: all 0.2s;
            width: 100%;
        }

        .file-item:hover {
            transform: translateY(-2px);
            background: #fff;
            box-shadow: 0 8px 16px -8px rgba(0, 0, 0, 0.06);
        }

        .file-item i {
            font-size: 1.2rem;
            margin-right: 12px;
            margin-top: 2px;
            color: #3c7aa6;
            width: 22px;
            flex-shrink: 0;
        }

        .file-item a {
            text-decoration: none;
            color: #1f4868;
            font-weight: 500;
            display: flex;
            align-items: flex-start;
            flex: 1;
            min-width: 0;
            word-break: break-word;
            white-space: normal;
            line-height: 1.4;
        }

        .file-item a span {
            word-break: break-word;
            white-space: normal;
        }

        .file-item a[href$=".html"]::after {
            content: " 🌐";
            margin-left: 6px;
            font-size: 0.75rem;
            opacity: 0.6;
            flex-shrink: 0;
            align-self: center;
        }

        .empty-folder {
            padding: 2rem;
            text-align: center;
            color: #7a99b3;
            font-style: italic;
        }

        /* ============================================
           9. 手机端适配 · 方案三：完全悬浮 (四周留白 + 圆角)
           ============================================ */
        @media (max-width: 768px) {
            body {
                padding: 1rem;
            }
            .container {
                height: calc(100vh - 2rem);
                max-height: none;
                border-radius: 2rem;
            }
            .header {
                padding: 16px 0 10px;
            }
            .header .ats {
                width: 80px;
                height: 80px;
            }
            .dropdown-section {
                padding: 12px 16px 0;
            }
            .dropdown-menu {
                max-height: 240px;
            }
        }

        @media (max-width: 480px) {
            .header {
                padding: 12px 0 8px;
            }
            .header .ats {
                width: 60px;
                height: 60px;
            }
            .nav-menu {
                padding: 8px 0;
            }
            .dropdown-section {
                padding: 8px 14px 0;
            }
            .content {
                padding: 0 14px 20px;
            }
            .dropdown-menu {
                max-height: 200px;
            }
            .file-item {
                padding: 0.8rem;
            }
        }
    </style>
</head>
<body>
<div class="container">
    <!-- 头部 Logo -->
    <div class="header">
        <img src="https://mzsx.netlify.app/app/img/favicon.ico" class="ats" alt="Logo">
    </div>

    <!-- 导航文字 -->
    <div class="nav-menu">
        <span class="menu-text"><i class="fas fa-download"></i> 资源下载</span>
    </div>

    <!-- 下拉区域 · 固定不滚动 -->
    <div class="dropdown-section">
        <div class="dropdown-wrapper" id="folderDropdown">
            <div class="dropdown-trigger" id="dropdownTrigger">
                <div class="trigger-left">
                    <span id="folderIconContainer">
                        <i class="fa-solid fa-folder-open" id="folderIconI"></i>
                        <img id="folderIconImg" src="" alt="" style="display: none; width: 1.5rem; height: 1.5rem; object-fit: contain;">
                    </span>
                    <span id="currentFolderName">HeMa</span>
                </div>
                <span class="arrow-icon">▼</span>
            </div>

            <div class="dropdown-menu" id="dropdownMenu">
                <ul></ul>
            </div>
        </div>
    </div>

    <!-- 可滚动内容区 -->
    <div class="content" id="downloads"></div>
</div>

<script>
    // ============================================
    // 0-HeMa 专属图标 (base64 webp)
    // ============================================
    const HEMA_ICON_BASE64 = "data:image/webp;base64,";

    // ============================================
    // 文件夹图标映射表
    // ============================================
    const FOLDER_ICON_MAP = {
        '0-HeMa': { type: 'image', value: HEMA_ICON_BASE64 },
        '1-在线工具': { type: 'icon', value: 'fa-solid fa-globe' },
        '2-Chrome扩展': { type: 'icon', value: 'fa-brands fa-chrome' },
        '3-Python脚本': { type: 'icon', value: 'fa-brands fa-python' },
        '4-Mac': { type: 'icon', value: 'fa-brands fa-apple' },
        '5-Windows': { type: 'icon', value: 'fa-brands fa-windows' },
        '6-Android': { type: 'icon', value: 'fa-brands fa-android' },
        'default': { type: 'icon', value: 'fa-solid fa-folder-open' }
    };

    // ============================================
    // 数据定义 (由脚本生成，这里保留示例数据)
    // ============================================
    const fileData = {
        '0-HeMa': [
            { name: '1-日报.xlsx', icon: 'fa-file-excel', path: 'hema/0-HeMa/1-日报.xlsx' },
            { name: '2-问单.xlsx', icon: 'fa-file-excel', path: 'hema/0-HeMa/2-问单.xlsx' },
            { name: '3-单袋比.xlsx', icon: 'fa-file-excel', path: 'hema/0-HeMa/3-单袋比.xlsx' },
            { name: '4-扣款记录.xlsx', icon: 'fa-file-excel', path: 'hema/0-HeMa/4-扣款记录.xlsx' },
            { name: '6-快捷指令-盒马.zip', icon: 'fa-file-archive', path: 'hema/0-HeMa/6-快捷指令-盒马.zip' },
            { name: '7-定制版二维码生成器.zip', icon: 'fa-file-archive', path: 'hema/0-HeMa/7-定制版二维码生成器.zip' },
        ],
        '1-在线工具': [
            { name: '0-文字转语音.html', icon: 'fa-file-code', path: 'hema/1-在线工具/0-文字转语音.html' },
            { name: '1-Excel秒变vCard.html', icon: 'fa-file-code', path: 'hema/1-在线工具/1-Excel秒变vCard.html' },
            { name: '2-文件目录树.html', icon: 'fa-file-code', path: 'hema/1-在线工具/2-文件目录树.html' },
            { name: '3-骑手热力-日报.html', icon: 'fa-file-code', path: 'hema/1-在线工具/3-骑手热力-日报.html' },
            { name: '4-骑手单袋比-领用分析工具.html', icon: 'fa-file-code', path: 'hema/1-在线工具/4-骑手单袋比-领用分析工具.html' },
            { name: 'TXT转通讯录.html', icon: 'fa-file-code', path: 'hema/1-在线工具/TXT转通讯录.html' },
        ],
        '2-Chrome扩展': [
            { name: '1-二维码生成-弹窗版.zip', icon: 'fa-file-archive', path: 'hema/2-Chrome扩展/1-二维码生成-弹窗版.zip' },
            { name: '2-二维码生成-悬浮窗.zip', icon: 'fa-file-archive', path: 'hema/2-Chrome扩展/2-二维码生成-悬浮窗.zip' },
            { name: '3-高级自定义标签页.zip', icon: 'fa-file-archive', path: 'hema/2-Chrome扩展/3-高级自定义标签页.zip' },
            { name: '视频变速器.zip', icon: 'fa-file-archive', path: 'hema/2-Chrome扩展/视频变速器.zip' },
        ],
        '3-Python脚本': [
            { name: '0-拖入py并运行.command', icon: 'fa-file', path: 'hema/3-Python脚本/0-拖入py并运行.command' },
            { name: '1-骑手指标分析.py', icon: 'fa-file-code', path: 'hema/3-Python脚本/1-骑手指标分析.py' },
            { name: '2-Excel转vCard助手.zip', icon: 'fa-file-archive', path: 'hema/3-Python脚本/2-Excel转vCard助手.zip' },
            { name: '3-MP3格式转换.py', icon: 'fa-file-code', path: 'hema/3-Python脚本/3-MP3格式转换.py' },
            { name: '4-一键分类存放.py', icon: 'fa-file-code', path: 'hema/3-Python脚本/4-一键分类存放.py' },
            { name: '一键删除修改时间超过30天的历史文件.py', icon: 'fa-file-code', path: 'hema/3-Python脚本/一键删除修改时间超过30天的历史文件.py' },
            { name: '删除创建时间超过30天文件并确认.py', icon: 'fa-file-code', path: 'hema/3-Python脚本/删除创建时间超过30天文件并确认.py' },
            { name: '将TXT文件转VCF格式-带界面.py', icon: 'fa-file-code', path: 'hema/3-Python脚本/将TXT文件转VCF格式-带界面.py' },
            { name: '自动归档.py', icon: 'fa-file-code', path: 'hema/3-Python脚本/自动归档.py' },
        ],
        '4-Mac': [
            { name: '1-MacOS屏蔽更新补丁.dmg', icon: 'fa-file', path: 'hema/4-Mac/1-MacOS屏蔽更新补丁.dmg' },
            { name: '11-磁盘没有正常推出.zip', icon: 'fa-file-archive', path: 'hema/4-Mac/11-磁盘没有正常推出.zip' },
            { name: '12-挂载nfts分区读写.zip', icon: 'fa-file-archive', path: 'hema/4-Mac/12-挂载nfts分区读写.zip' },
            { name: '13-一键文件夹目录树py.zip', icon: 'fa-file-archive', path: 'hema/4-Mac/13-一键文件夹目录树py.zip' },
            { name: 'Python脚本运行器.command', icon: 'fa-file', path: 'hema/4-Mac/Python脚本运行器.command' },
            { name: '单硬盘挂载EFI分区2.0.command', icon: 'fa-file', path: 'hema/4-Mac/单硬盘挂载EFI分区2.0.command' },
            { name: '显示隐藏文件.zip', icon: 'fa-file-archive', path: 'hema/4-Mac/显示隐藏文件.zip' },
        ],
        '5-Windows': [
            { name: 'BCM94360Z4.zip', icon: 'fa-file-archive', path: 'hema/5-Windows/BCM94360Z4.zip' },
            { name: 'KMS激活.zip', icon: 'fa-file-archive', path: 'hema/5-Windows/KMS激活.zip' },
            { name: 'MAS激活.zip', icon: 'fa-file-archive', path: 'hema/5-Windows/MAS激活.zip' },
            { name: 'NFC门禁卡软件.exe', icon: 'fa-file', path: 'hema/5-Windows/NFC门禁卡软件.exe' },
            { name: 'office365.zip', icon: 'fa-file-archive', path: 'hema/5-Windows/office365.zip' },
            { name: '一键开关Defender.zip', icon: 'fa-file-archive', path: 'hema/5-Windows/一键开关Defender.zip' },
        ],
        '6-Android': [
            { name: 'T9_v1.3.apk', icon: 'fa-file', path: 'hema/6-Android/T9_v1.3.apk' },
            { name: 'via浏览器.apk', icon: 'fa-file', path: 'hema/6-Android/via浏览器.apk' },
            { name: '应用提取.apk', icon: 'fa-file', path: 'hema/6-Android/应用提取.apk' },
            { name: '搜狗输入法.apk', icon: 'fa-file', path: 'hema/6-Android/搜狗输入法.apk' },
            { name: '时间窗_v1.5.4.apk', icon: 'fa-file', path: 'hema/6-Android/时间窗_v1.5.4.apk' },
            { name: '条码扫描器_v1.24.2.apk', icon: 'fa-file', path: 'hema/6-Android/条码扫描器_v1.24.2.apk' },
            { name: '百度输入法.apk.zip', icon: 'fa-file-archive', path: 'hema/6-Android/百度输入法.apk.zip' },
            { name: '通讯录助手_v1.7.2.apk', icon: 'fa-file', path: 'hema/6-Android/通讯录助手_v1.7.2.apk' },
        ],
    };

    (function() {
        // ---------- 辅助函数：提取排序数字，隐藏前缀显示名 ----------
        function extractSortNumber(folderName) {
            const match = folderName.match(/^(\d+)-/);
            return match ? parseInt(match[1], 10) : 9999;
        }

        function getDisplayName(folderName) {
            return folderName.replace(/^\d+-/, '');
        }

        function getFileDisplayName(fileName) {
            return fileName.replace(/^\d+-/, '');
        }

        // ---------- 获取文件夹图标HTML ----------
        function getFolderIconHtml(folderId) {
            const config = FOLDER_ICON_MAP[folderId] || FOLDER_ICON_MAP['default'];
            if (config.type === 'image') {
                return `<img src="${config.value}" alt="" style="width:1.2rem;height:1.2rem;object-fit:contain;">`;
            } else {
                return `<i class="${config.value}"></i>`;
            }
        }

        // ---------- 获取所有文件夹 (排除root) ----------
        const folderIds = Object.keys(fileData).filter(id => id !== 'root');
        folderIds.sort((a, b) => extractSortNumber(a) - extractSortNumber(b));

        // ---------- DOM 元素 ----------
        const wrapper = document.getElementById('folderDropdown');
        const trigger = document.getElementById('dropdownTrigger');
        const folderNameSpan = document.getElementById('currentFolderName');
        const dropdownMenuUl = document.querySelector('#dropdownMenu ul');
        const contentDiv = document.getElementById('downloads');
        
        const iconI = document.getElementById('folderIconI');
        const iconImg = document.getElementById('folderIconImg');

        const panels = {};

        // ---------- 构建下拉菜单 & 面板 ----------
        function buildUI() {
            dropdownMenuUl.innerHTML = '';
            
            folderIds.forEach(folderId => {
                const display = getDisplayName(folderId);
                const li = document.createElement('li');
                li.dataset.folder = folderId;
                li.dataset.name = folderId;
                li.innerHTML = `${getFolderIconHtml(folderId)} ${display}`;
                dropdownMenuUl.appendChild(li);
                
                if (!panels[folderId]) {
                    const panel = document.createElement('div');
                    panel.className = 'file-panel';
                    panel.id = `panel-${folderId}`;
                    panel.style.display = 'none';
                    contentDiv.appendChild(panel);
                    panels[folderId] = panel;
                }
            });

            folderIds.forEach(id => renderFiles(id));
        }

        // ---------- 渲染文件列表 ----------
        function renderFiles(folderId) {
            const panel = panels[folderId];
            if (!panel) return;
            const files = fileData[folderId] || [];
            
            if (!files.length) {
                panel.innerHTML = '<div class="empty-folder"><i class="fa-regular fa-folder-open"></i> 暂无文件</div>';
                return;
            }

            let html = '';
            files.forEach(file => {
                const displayName = getFileDisplayName(file.name);
                const isHtml = file.name.toLowerCase().endsWith('.html');
                const targetAttr = isHtml ? ' target="_blank" rel="noopener noreferrer"' : '';
                html += `<div class="file-item"><a href="${file.path}"${targetAttr} data-original-name="${file.name}"><i class="fas ${file.icon}"></i><span>「${displayName}」</span></a></div>`;
            });
            panel.innerHTML = html;
            bindDownloadEventsForPanel(panel);
        }

        // ---------- 切换文件夹 ----------
        function switchFolder(folderId) {
            const displayName = getDisplayName(folderId);
            folderNameSpan.textContent = displayName;
            
            document.querySelectorAll('#dropdownMenu li').forEach(item => {
                item.classList.toggle('active', item.dataset.folder === folderId);
            });
            
            Object.values(panels).forEach(p => p.style.display = 'none');
            if (panels[folderId]) panels[folderId].style.display = 'block';
            
            updateFolderIcon(folderId);
            wrapper.classList.remove('open');
        }

        // ---------- 更新标题栏图标 ----------
        function updateFolderIcon(folderId) {
            const config = FOLDER_ICON_MAP[folderId] || FOLDER_ICON_MAP['default'];
            
            if (config.type === 'image') {
                iconI.style.display = 'none';
                iconImg.src = config.value;
                iconImg.style.display = 'inline-block';
            } else {
                iconImg.style.display = 'none';
                iconI.style.display = 'inline-block';
                iconI.className = config.value;
            }
        }

        // ---------- 下载处理（隐藏前缀 + 日期后缀）----------
        function handleDownload(e) {
            const href = this.getAttribute('href') || '';
            if (href.toLowerCase().endsWith('.html')) return;
            
            e.preventDefault();
            
            let originalName = this.dataset.originalName;
            if (!originalName) {
                originalName = href.substring(href.lastIndexOf('/') + 1);
            }
            
            const baseName = getFileDisplayName(originalName);
            const now = new Date();
            const dateStr = now.getFullYear().toString().slice(-2) + 
                           (now.getMonth() + 1).toString().padStart(2, '0') + 
                           now.getDate().toString().padStart(2, '0');
            
            const lastDot = baseName.lastIndexOf('.');
            const newName = lastDot > 0 
                ? baseName.slice(0, lastDot) + '-' + dateStr + baseName.slice(lastDot)
                : baseName + '-' + dateStr;
            
            const a = document.createElement('a');
            a.href = href;
            a.download = newName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        function bindDownloadEventsForPanel(panel) {
            panel.querySelectorAll('a').forEach(link => {
                link.removeEventListener('click', handleDownload);
                link.addEventListener('click', handleDownload);
                if (link.href.toLowerCase().endsWith('.html')) {
                    link.target = '_blank';
                    link.rel = 'noopener noreferrer';
                }
                if (!link.dataset.originalName) {
                    const href = link.getAttribute('href') || '';
                    const name = href.substring(href.lastIndexOf('/') + 1);
                    link.dataset.originalName = name;
                }
            });
        }

        // ---------- 初始化 ----------
        function init() {
            buildUI();
            
            if (folderIds.length === 0) {
                folderNameSpan.textContent = '暂无文件夹';
                return;
            }
            
            const firstId = folderIds[0];
            switchFolder(firstId);
            
            trigger.addEventListener('click', e => {
                e.stopPropagation();
                wrapper.classList.toggle('open');
            });
            
            dropdownMenuUl.addEventListener('click', e => {
                const li = e.target.closest('li');
                if (!li) return;
                e.stopPropagation();
                switchFolder(li.dataset.folder);
            });
            
            document.addEventListener('click', e => {
                if (!wrapper.contains(e.target)) wrapper.classList.remove('open');
            });
            
            document.addEventListener('keydown', e => {
                if (e.key === 'Escape') wrapper.classList.remove('open');
            });
        }

        init();
    })();
</script>
</body>
</html>