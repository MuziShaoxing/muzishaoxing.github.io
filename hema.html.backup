<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=yes">
    <title>盒马 · 方案一 · 柔和卡片</title>
    <meta name="author" content="少星">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="shortcut icon" href="https://mzsx.netlify.app/app/img/favicon.ico">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: linear-gradient(145deg, #f1f5f9 0%, #e4eaf1 100%);
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            height: 100vh; overflow: hidden; padding: 1.5rem 1rem;
            display: flex; justify-content: center; align-items: center;
        }
        .container {
            width: 100%; max-width: 520px; height: calc(100vh - 3rem); max-height: 900px;
            background: rgba(255,255,255,0.7); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
            border-radius: 2rem; box-shadow: 0 20px 40px -12px rgba(0,20,40,0.12);
            border: 1px solid rgba(255,255,255,0.5); display: flex; flex-direction: column; overflow: hidden;
        }
        .header { display: flex; justify-content: center; align-items: center; padding: 24px 0 14px; flex-shrink: 0; }
        .header .ats { width: 72px; height: 72px; border-radius: 18px; object-fit: cover; box-shadow: 0 6px 12px rgba(0,0,0,0.04); }
        .nav-menu { padding: 10px 0; text-align: center; background: rgba(248,250,252,0.4); border-bottom: 1px solid rgba(203,221,238,0.4); flex-shrink: 0; }
        .nav-menu .menu-text { font-size: 1rem; color: #2c5f7e; font-weight: 500; }
        .nav-menu i { margin-right: 6px; color: #3e7b9f; }
        .dropdown-section { padding: 18px 20px 0; flex-shrink: 0; }
        .dropdown-wrapper { position: relative; margin-bottom: 16px; }
        .dropdown-trigger {
            width: 100%; background: #fff; border: 1.5px solid #cfdfec; border-radius: 1.4rem;
            padding: 0.9rem 1.2rem; font-size: 1rem; font-weight: 500; display: flex;
            justify-content: space-between; align-items: center; cursor: pointer; color: #1f4662;
            transition: all 0.2s;
        }
        .dropdown-trigger:hover { background: #fefefe; border-color: #9bbad2; }
        .trigger-left { display: flex; align-items: center; gap: 10px; }
        .trigger-left i, .trigger-left img { font-size: 1.3rem; color: #2c7eb6; width: 1.5rem; height: 1.5rem; object-fit: contain; }
        .arrow-icon { font-size: 1.2rem; color: #7097b3; transition: transform 0.25s; }
        .dropdown-wrapper.open .arrow-icon { transform: rotate(180deg); }
        .dropdown-menu {
            position: absolute; top: calc(100% + 8px); left: 0; width: 100%; max-height: 280px;
            background: #fff; border-radius: 1.2rem; box-shadow: 0 12px 28px rgba(0,0,0,0.08);
            z-index: 100; overflow-y: auto; overflow-x: hidden; scrollbar-width: none; -ms-overflow-style: none;
            opacity: 0; visibility: hidden; transform: translateY(-8px); transition: all 0.2s;
            border: 1px solid #e2edf6;
        }
        .dropdown-menu::-webkit-scrollbar { display: none; }
        .dropdown-wrapper.open .dropdown-menu { opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown-menu ul { list-style: none; padding: 0.4rem 0; }
        .dropdown-menu li {
            padding: 0.8rem 1.2rem; cursor: pointer; font-size: 0.95rem; display: flex; align-items: center;
            gap: 0.8rem; color: #1e4d6b; transition: background 0.15s; word-break: break-word; white-space: normal;
        }
        .dropdown-menu li:hover { background: #f0f7fe; }
        .dropdown-menu li.active { background: #e3f0fd; color: #1c6b9e; }
        .dropdown-menu li i, .dropdown-menu li img { width: 22px; color: #5882a8; flex-shrink: 0; }
        .dropdown-menu li img { object-fit: contain; height: 1.2rem; }
        .content {
            padding: 0 20px 30px; flex: 1; overflow-y: auto; overflow-x: hidden;
            scrollbar-width: none; -ms-overflow-style: none;
        }
        .content::-webkit-scrollbar { display: none; }
        .file-panel { padding-top: 4px; width: 100%; }
        .file-item {
            display: flex; align-items: flex-start; padding: 0.9rem 1rem; margin-bottom: 8px;
            background: rgba(255,255,255,0.6); border-radius: 1.2rem; border: 1px solid #eaf1f9;
            transition: all 0.2s; width: 100%;
        }
        .file-item:hover { transform: translateY(-2px); background: #fff; box-shadow: 0 8px 16px -8px rgba(0,0,0,0.06); }
        .file-item i { font-size: 1.2rem; margin-right: 12px; margin-top: 2px; color: #3c7aa6; width: 22px; flex-shrink: 0; }
        .file-item a {
            text-decoration: none; color: #1f4868; font-weight: 500; display: flex; align-items: flex-start;
            flex: 1; min-width: 0; word-break: break-word; white-space: normal; line-height: 1.4;
        }
        .file-item a span { word-break: break-word; white-space: normal; }
        .file-item a[href$=".html"]::after { content: " 🌐"; margin-left: 6px; font-size: 0.75rem; opacity: 0.6; flex-shrink: 0; align-self: center; }
        .empty-folder { padding: 2rem; text-align: center; color: #7a99b3; font-style: italic; }

        /* 方案一：柔和卡片 */
        @media (max-width: 768px) {
            body { padding: 12px; }
            .container { height: calc(100vh - 24px); max-height: none; border-radius: 1.8rem; }
            .header { padding: 16px 0 10px; }
            .header .ats { width: 80px; height: 80px; }
            .dropdown-section { padding: 12px 16px 0; }
            .dropdown-menu { max-height: 240px; }
        }
        @media (max-width: 480px) {
            .header { padding: 12px 0 8px; }
            .header .ats { width: 60px; height: 60px; }
            .nav-menu { padding: 8px 0; }
            .dropdown-section { padding: 8px 14px 0; }
            .content { padding: 0 14px 20px; }
            .dropdown-menu { max-height: 200px; }
            .file-item { padding: 0.8rem; }
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header"><img src="https://mzsx.netlify.app/app/img/favicon.ico" class="ats" alt="Logo"></div>
    <div class="nav-menu"><span class="menu-text"><i class="fas fa-download"></i> 资源下载</span></div>
    <div class="dropdown-section">
        <div class="dropdown-wrapper" id="folderDropdown">
            <div class="dropdown-trigger" id="dropdownTrigger">
                <div class="trigger-left">
                    <span id="folderIconContainer"><i class="fa-solid fa-folder-open" id="folderIconI"></i><img id="folderIconImg" src="" alt="" style="display:none; width:1.5rem; height:1.5rem; object-fit:contain;"></span>
                    <span id="currentFolderName">HeMa</span>
                </div>
                <span class="arrow-icon">▼</span>
            </div>
            <div class="dropdown-menu" id="dropdownMenu"><ul></ul></div>
        </div>
    </div>
    <div class="content" id="downloads"></div>
</div>
<script>
    const HEMA_ICON_BASE64 = "data:image/webp;base64,";
    const FOLDER_ICON_MAP = {
        '0-HeMa': { type: 'image', value: HEMA_ICON_BASE64 },
        '1-在线工具': { type: 'icon', value: 'fa-solid fa-globe' },
        '2-Chrome扩展': { type: 'icon', value: 'fa-brands fa-chrome' },
        '3-Python脚本': { type: 'icon', value: 'fa-brands fa-python' },
        '4-Mac': { type: 'icon', value: 'fa-brands fa-apple' },
        '5-Windows': { type: 'icon', value: 'fa-brands fa-windows' },
        '6-Android': { type: 'icon', value: 'fa-brands fa-android' },
        'default': { type: 'icon', value: 'fa-solid fa-folder-open' }
    };
    const fileData = {
        '0-HeMa': [ { name: '1-日报.xlsx', icon: 'fa-file-excel', path: 'hema/0-HeMa/1-日报.xlsx' }, { name: '2-问单.xlsx', icon: 'fa-file-excel', path: 'hema/0-HeMa/2-问单.xlsx' } ],
        '1-在线工具': [ { name: 'Excel 秒变 vCard.html', icon: 'fa-file-code', path: 'hema/1-在线工具/Excel 秒变 vCard.html' } ],
        '2-Chrome扩展': [ { name: '二维码生成-弹窗版.zip', icon: 'fa-file-archive', path: 'hema/2-Chrome扩展/二维码生成-弹窗版.zip' } ],
        '3-Python脚本': [ { name: 'MP3格式转换.py', icon: 'fa-file-code', path: 'hema/3-Python脚本/MP3格式转换.py' } ],
        '4-Mac': [ { name: 'MacOS屏蔽更新补丁.dmg', icon: 'fa-file', path: 'hema/4-Mac/MacOS屏蔽更新补丁.dmg' } ],
        '5-Windows': [ { name: 'KMS激活.zip', icon: 'fa-file-archive', path: 'hema/5-Windows/KMS激活.zip' } ],
        '6-Android': [ { name: 'via浏览器.apk', icon: 'fa-file', path: 'hema/6-Android/via浏览器.apk' } ]
    };
    (function(){
        function extractSortNumber(n){ let m=n.match(/^(\d+)-/); return m?parseInt(m[1]):9999; }
        function getDisplayName(n){ return n.replace(/^\d+-/,''); }
        function getFileDisplayName(n){ return n.replace(/^\d+-/,''); }
        function getFolderIconHtml(id){ let c=FOLDER_ICON_MAP[id]||FOLDER_ICON_MAP['default']; return c.type==='image'?`<img src="${c.value}" alt="" style="width:1.2rem;height:1.2rem;object-fit:contain;">`:`<i class="${c.value}"></i>`; }
        const folderIds=Object.keys(fileData).filter(id=>id!=='root').sort((a,b)=>extractSortNumber(a)-extractSortNumber(b));
        const wrapper=document.getElementById('folderDropdown'), trigger=document.getElementById('dropdownTrigger'), folderNameSpan=document.getElementById('currentFolderName'), dropdownMenuUl=document.querySelector('#dropdownMenu ul'), contentDiv=document.getElementById('downloads');
        const iconI=document.getElementById('folderIconI'), iconImg=document.getElementById('folderIconImg');
        const panels={};
        function buildUI(){
            dropdownMenuUl.innerHTML='';
            folderIds.forEach(id=>{
                let li=document.createElement('li'); li.dataset.folder=id; li.dataset.name=id;
                li.innerHTML=getFolderIconHtml(id)+' '+getDisplayName(id);
                dropdownMenuUl.appendChild(li);
                if(!panels[id]){ let p=document.createElement('div'); p.className='file-panel'; p.id='panel-'+id; p.style.display='none'; contentDiv.appendChild(p); panels[id]=p; }
            });
            folderIds.forEach(id=>renderFiles(id));
        }
        function renderFiles(id){
            let panel=panels[id]; if(!panel) return;
            let files=fileData[id]||[];
            if(!files.length){ panel.innerHTML='<div class="empty-folder"><i class="fa-regular fa-folder-open"></i> 暂无文件</div>'; return; }
            let html='';
            files.forEach(f=>{ let dn=getFileDisplayName(f.name); let isHtml=f.name.toLowerCase().endsWith('.html'); let ta=isHtml?' target="_blank" rel="noopener noreferrer"':''; html+=`<div class="file-item"><a href="${f.path}"${ta} data-original-name="${f.name}"><i class="fas ${f.icon}"></i><span>「${dn}」</span></a></div>`; });
            panel.innerHTML=html; bindDownloadEvents(panel);
        }
        function switchFolder(id){
            folderNameSpan.textContent=getDisplayName(id);
            document.querySelectorAll('#dropdownMenu li').forEach(li=>li.classList.toggle('active',li.dataset.folder===id));
            Object.values(panels).forEach(p=>p.style.display='none'); if(panels[id]) panels[id].style.display='block';
            updateFolderIcon(id); wrapper.classList.remove('open');
        }
        function updateFolderIcon(id){
            let c=FOLDER_ICON_MAP[id]||FOLDER_ICON_MAP['default'];
            if(c.type==='image'){ iconI.style.display='none'; iconImg.src=c.value; iconImg.style.display='inline-block'; }
            else { iconImg.style.display='none'; iconI.style.display='inline-block'; iconI.className=c.value; }
        }
        function handleDownload(e){
            let href=this.getAttribute('href'); if(href.toLowerCase().endsWith('.html')) return;
            e.preventDefault();
            let orig=this.dataset.originalName; if(!orig) orig=href.substring(href.lastIndexOf('/')+1);
            let base=getFileDisplayName(orig);
            let now=new Date(); let ds=now.getFullYear().toString().slice(-2)+(now.getMonth()+1).toString().padStart(2,'0')+now.getDate().toString().padStart(2,'0');
            let ld=base.lastIndexOf('.'); let nn=ld>0?base.slice(0,ld)+'-'+ds+base.slice(ld):base+'-'+ds;
            let a=document.createElement('a'); a.href=href; a.download=nn; document.body.appendChild(a); a.click(); document.body.removeChild(a);
        }
        function bindDownloadEvents(panel){
            panel.querySelectorAll('a').forEach(a=>{
                a.removeEventListener('click',handleDownload); a.addEventListener('click',handleDownload);
                if(a.href.toLowerCase().endsWith('.html')){ a.target='_blank'; a.rel='noopener noreferrer'; }
                if(!a.dataset.originalName){ let h=a.getAttribute('href'); a.dataset.originalName=h.substring(h.lastIndexOf('/')+1); }
            });
        }
        function init(){
            buildUI();
            if(!folderIds.length){ folderNameSpan.textContent='暂无文件夹'; return; }
            switchFolder(folderIds[0]);
            trigger.addEventListener('click',e=>{ e.stopPropagation(); wrapper.classList.toggle('open'); });
            dropdownMenuUl.addEventListener('click',e=>{ let li=e.target.closest('li'); if(li){ e.stopPropagation(); switchFolder(li.dataset.folder); } });
            document.addEventListener('click',e=>{ if(!wrapper.contains(e.target)) wrapper.classList.remove('open'); });
            document.addEventListener('keydown',e=>{ if(e.key==='Escape') wrapper.classList.remove('open'); });
        }
        init();
    })();
</script>
</body>
</html>