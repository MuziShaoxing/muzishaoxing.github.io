<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=yes">
    <title>盒马 · 常用文件</title>
    <meta name="author" content="少星">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="shortcut icon" href="https://mzsx.netlify.app/app/img/favicon.ico">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: linear-gradient(145deg, #f1f5f9 0%, #e4eaf1 100%);
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            height: 100vh;
            overflow: hidden;
            padding: 1.5rem 1rem;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .container {
            width: 100%;
            max-width: 520px;
            height: calc(100vh - 3rem);
            max-height: 900px;
            background: rgba(255,255,255,0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 2rem;
            box-shadow: 0 20px 40px -12px rgba(0,20,40,0.12);
            border: 1px solid rgba(255,255,255,0.5);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .header {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 24px 0 14px;
            flex-shrink: 0;
        }
        .header .ats {
            width: 72px;
            height: 72px;
            border-radius: 18px;
            object-fit: cover;
            box-shadow: 0 6px 12px rgba(0,0,0,0.04);
        }
        .nav-menu {
            padding: 10px 0;
            text-align: center;
            background: rgba(248,250,252,0.4);
            border-bottom: 1px solid rgba(203,221,238,0.4);
            flex-shrink: 0;
        }
        .nav-menu .menu-text {
            font-size: 1rem;
            color: #2c5f7e;
            font-weight: 500;
        }
        .nav-menu i {
            margin-right: 6px;
            color: #3e7b9f;
        }
        .dropdown-section {
            padding: 18px 20px 0;
            flex-shrink: 0;
        }
        .dropdown-wrapper {
            position: relative;
            margin-bottom: 16px;
        }
        .dropdown-trigger {
            width: 100%;
            background: #fff;
            border: 1.5px solid #cfdfec;
            border-radius: 1.4rem;
            padding: 0.9rem 1.2rem;
            font-size: 1rem;
            font-weight: 500;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            color: #1f4662;
            transition: all 0.2s;
        }
        .dropdown-trigger:hover { background: #fefefe; border-color: #9bbad2; }
        .trigger-left { display: flex; align-items: center; gap: 10px; }
        .trigger-left i, .trigger-left img { font-size: 1.3rem; color: #2c7eb6; width: 1.5rem; height: 1.5rem; object-fit: contain; }
        .arrow-icon { font-size: 1.2rem; color: #7097b3; transition: transform 0.25s; }
        .dropdown-wrapper.open .arrow-icon { transform: rotate(180deg); }
        .dropdown-menu {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            width: 100%;
            max-height: 280px;
            background: #fff;
            border-radius: 1.2rem;
            box-shadow: 0 12px 28px rgba(0,0,0,0.08);
            z-index: 100;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: none;
            -ms-overflow-style: none;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: all 0.2s;
        }
        .dropdown-menu::-webkit-scrollbar { display: none; }
        .dropdown-wrapper.open .dropdown-menu { opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown-menu ul { list-style: none; padding: 0.4rem 0; }
        .dropdown-menu li {
            padding: 0.8rem 1.2rem;
            cursor: pointer;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.8rem;
            color: #1e4d6b;
            transition: background 0.15s;
            word-break: break-word;
            white-space: normal;
        }
        .dropdown-menu li:hover { background: #f0f7fe; }
        .dropdown-menu li.active { background: #e3f0fd; color: #1c6b9e; }
        .dropdown-menu li i, .dropdown-menu li img { width: 22px; color: #5882a8; flex-shrink: 0; }
        .dropdown-menu li img { object-fit: contain; height: 1.2rem; }

        .content {
            padding: 0 20px 0;
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        .content::-webkit-scrollbar { display: none; }

        /* 固定在底部的返回按钮 */
        .back-bar {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 10px 20px;
            font-size: 0.95rem;
            color: #3c7aa6;
            cursor: pointer;
            user-select: none;
            flex-shrink: 0;
            border-top: 1px solid rgba(203,221,238,0.4);
            background: rgba(255,255,255,0.5);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            visibility: hidden;
            height: 0;
            overflow: hidden;
            transition: all 0.2s;
        }
        .back-bar.visible {
            visibility: visible;
            height: auto;
            padding: 12px 20px;
        }
        .back-bar i { margin-right: 8px; }
        .back-bar span { font-weight: 500; }

        .file-panel { padding-top: 4px; width: 100%; }
        .file-item {
            display: flex;
            align-items: center;
            padding: 0.9rem 1rem;
            margin-bottom: 8px;
            background: rgba(255,255,255,0.6);
            border-radius: 1.2rem;
            border: 1px solid #eaf1f9;
            transition: all 0.2s;
            width: 100%;
            cursor: default;
        }
        .file-item.folder-entry {
            cursor: pointer;
        }
        .file-item:hover { transform: translateY(-2px); background: #fff; box-shadow: 0 8px 16px -8px rgba(0,0,0,0.06); }
        .file-item i { font-size: 1.2rem; margin-right: 12px; color: #3c7aa6; width: 22px; flex-shrink: 0; }
        .file-item a {
            text-decoration: none;
            color: #1f4868;
            font-weight: 500;
            display: flex;
            align-items: center;
            flex: 1;
            min-width: 0;
            word-break: break-word;
            white-space: normal;
            line-height: 1.4;
        }
        .file-item a span { word-break: break-word; white-space: normal; }
        .file-item a[href$=".html"]::after { content: " 🌐"; margin-left: 6px; font-size: 0.75rem; opacity: 0.6; flex-shrink: 0; }
        .empty-folder { padding: 2rem; text-align: center; color: #7a99b3; font-style: italic; }

        /* 手机端方案三：完全悬浮 */
        @media (max-width: 768px) {
            body { padding: 1rem; }
            .container { height: calc(100vh - 2rem); max-height: none; border-radius: 2rem; }
            .header { padding: 16px 0 10px; }
            .header .ats { width: 80px; height: 80px; }
            .dropdown-section { padding: 12px 16px 0; }
            .dropdown-menu { max-height: 240px; }
            .back-bar.visible { padding: 10px 16px; }
        }
        @media (max-width: 480px) {
            .header { padding: 12px 0 8px; }
            .header .ats { width: 60px; height: 60px; }
            .nav-menu { padding: 8px 0; }
            .dropdown-section { padding: 8px 14px 0; }
            .content { padding: 0 14px 0; }
            .dropdown-menu { max-height: 200px; }
            .file-item { padding: 0.8rem; }
            .back-bar.visible { padding: 8px 14px; font-size: 0.9rem; }
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <img src="https://mzsx.netlify.app/app/img/favicon.ico" class="ats" alt="Logo">
    </div>
    <div class="nav-menu">
        <span class="menu-text"><i class="fas fa-download"></i> 资源下载</span>
    </div>
    <div class="dropdown-section">
        <div class="dropdown-wrapper" id="folderDropdown">
            <div class="dropdown-trigger" id="dropdownTrigger">
                <div class="trigger-left">
                    <span id="folderIconContainer">
                        <i class="fa-solid fa-folder-open" id="folderIconI"></i>
                        <img id="folderIconImg" src="" alt="" style="display: none; width: 1.5rem; height: 1.5rem; object-fit: contain;">
                    </span>
                    <span id="currentFolderName">HeMa</span>
                </div>
                <span class="arrow-icon">▼</span>
            </div>
            <div class="dropdown-menu" id="dropdownMenu"><ul></ul></div>
        </div>
    </div>

    <!-- 内容区域（可滚动） -->
    <div class="content" id="downloads"></div>

    <!-- 返回按钮固定在底部 -->
    <div class="back-bar" id="backButtonContainer">
        <i class="fa-solid fa-arrow-left"></i> <span id="backButtonText">返回</span>
    </div>
</div>

<script>
    const HEMA_ICON_BASE64 = "data:image/webp;base64,";

    const FOLDER_ICON_MAP = {
        '0-HeMa': { type: 'image', value: HEMA_ICON_BASE64 },
        '1-在线工具': { type: 'icon', value: 'fa-solid fa-globe' },
        '2-Chrome扩展': { type: 'icon', value: 'fa-brands fa-chrome' },
        '3-Python脚本': { type: 'icon', value: 'fa-brands fa-python' },
        '4-Mac': { type: 'icon', value: 'fa-brands fa-apple' },
        '5-Windows': { type: 'icon', value: 'fa-brands fa-windows' },
        '6-Android': { type: 'icon', value: 'fa-brands fa-android' },
        'default': { type: 'icon', value: 'fa-solid fa-folder-open' }
    };

    // 数据结构（一级文件夹包含 files 和 folders，子文件夹为 { name, files }）
    const fileData = {
        '0-HeMa': {
            files: [
                { name: '1-日报.xlsx', icon: 'fa-file-excel', path: 'hema/0-HeMa/1-日报.xlsx' },
                { name: '2-问单.xlsx', icon: 'fa-file-excel', path: 'hema/0-HeMa/2-问单.xlsx' },
            ],
            folders: {
                'sub-example': {
                    name: '子目录示例',
                    files: [
                        { name: '子文件.txt', icon: 'fa-file-alt', path: 'hema/0-HeMa/子目录示例/子文件.txt' }
                    ]
                }
            }
        },
        '1-在线工具': {
            files: [
                { name: 'Excel 秒变 vCard.html', icon: 'fa-file-code', path: 'hema/1-在线工具/Excel 秒变 vCard.html' },
            ],
            folders: {}
        },
        // 其他文件夹同理，实际由 Python 生成
    };

    (function() {
        function extractSortNumber(name) { const m = name.match(/^(\d+)-/); return m ? parseInt(m[1],10) : 9999; }
        function getDisplayName(name) { return name.replace(/^\d+-/, ''); }
        function getFileDisplayName(name) { return name.replace(/^\d+-/, ''); }

        function getFolderIconHtml(folderId) {
            const config = FOLDER_ICON_MAP[folderId] || FOLDER_ICON_MAP['default'];
            if (config.type === 'image') return `<img src="${config.value}" style="width:1.2rem;height:1.2rem;object-fit:contain;">`;
            return `<i class="${config.value}"></i>`;
        }

        const folderIds = Object.keys(fileData).filter(id => id !== 'root');
        folderIds.sort((a,b) => extractSortNumber(a) - extractSortNumber(b));

        const wrapper = document.getElementById('folderDropdown');
        const trigger = document.getElementById('dropdownTrigger');
        const folderNameSpan = document.getElementById('currentFolderName');
        const dropdownMenuUl = document.querySelector('#dropdownMenu ul');
        const contentDiv = document.getElementById('downloads');
        const backBar = document.getElementById('backButtonContainer');
        const backText = document.getElementById('backButtonText');
        const iconI = document.getElementById('folderIconI');
        const iconImg = document.getElementById('folderIconImg');

        let currentPath = [];

        function buildUIContainers() {
            dropdownMenuUl.innerHTML = '';
            folderIds.forEach(fid => {
                const li = document.createElement('li');
                li.dataset.folder = fid;
                li.innerHTML = `${getFolderIconHtml(fid)} ${getDisplayName(fid)}`;
                dropdownMenuUl.appendChild(li);
            });
        }

        function renderCurrentLevel() {
            if (currentPath.length === 0) {
                contentDiv.innerHTML = '<div class="empty-folder"><i class="fa-regular fa-folder-open"></i> 请选择一个文件夹</div>';
                updateBackButton();
                return;
            }
            const topId = currentPath[0];
            let node = fileData[topId];
            if (!node) {
                contentDiv.innerHTML = '<div class="empty-folder">文件夹不存在</div>';
                updateBackButton();
                return;
            }
            for (let i = 1; i < currentPath.length; i++) {
                const subId = currentPath[i];
                if (node.folders && node.folders[subId]) {
                    node = node.folders[subId];
                } else {
                    contentDiv.innerHTML = '<div class="empty-folder">子文件夹不存在</div>';
                    updateBackButton();
                    return;
                }
            }

            const files = node.files || [];
            const folders = node.folders || {};
            const subFolderIds = Object.keys(folders);
            let html = '';

            // 子文件夹：只显示文件夹图标和名称
            subFolderIds.forEach(sid => {
                const folder = folders[sid];
                const displayName = getFileDisplayName(folder.name || sid);
                html += `<div class="file-item folder-entry" data-subfolder="${sid}">
                    <i class="fa-solid fa-folder-open" style="color:#d97706;"></i>
                    <span style="font-weight:500; color:#1f4868;">${displayName}</span>
                </div>`;
            });

            // 文件列表
            if (files.length === 0 && subFolderIds.length === 0) {
                html += '<div class="empty-folder"><i class="fa-regular fa-folder-open"></i> 暂无文件</div>';
            } else {
                files.forEach(file => {
                    const displayName = getFileDisplayName(file.name);
                    const isHtml = file.name.toLowerCase().endsWith('.html');
                    const targetAttr = isHtml ? ' target="_blank" rel="noopener noreferrer"' : '';
                    html += `<div class="file-item"><a href="${file.path}"${targetAttr} data-original-name="${file.name}"><i class="fas ${file.icon}"></i><span>「${displayName}」</span></a></div>`;
                });
            }

            contentDiv.innerHTML = html;
            bindEventsInPanel();
            updateBackButton();
        }

        function bindEventsInPanel() {
            contentDiv.querySelectorAll('.folder-entry').forEach(entry => {
                entry.addEventListener('click', function(e) {
                    const subId = this.dataset.subfolder;
                    if (subId) {
                        currentPath.push(subId);
                        renderCurrentLevel();
                    }
                });
            });

            contentDiv.querySelectorAll('a[href]').forEach(link => {
                link.removeEventListener('click', handleDownload);
                link.addEventListener('click', handleDownload);
                if (link.href.toLowerCase().endsWith('.html')) {
                    link.target = '_blank';
                    link.rel = 'noopener noreferrer';
                }
                if (!link.dataset.originalName) {
                    const href = link.getAttribute('href') || '';
                    const name = href.substring(href.lastIndexOf('/') + 1);
                    link.dataset.originalName = name;
                }
            });
        }

        function updateBackButton() {
            if (currentPath.length > 1) {
                backBar.classList.add('visible');
                // 取得上一级目录名称
                const prevPath = currentPath.slice(0, -1);
                const prevNode = getNodeByPath(prevPath);
                const display = prevNode ? (getFileDisplayName(prevNode.name) || '上级') : '返回';
                backText.textContent = display;
            } else {
                backBar.classList.remove('visible');
            }
        }

        function getNodeByPath(pathArr) {
            if (pathArr.length === 0) return null;
            let node = fileData[pathArr[0]];
            for (let i = 1; i < pathArr.length; i++) {
                node = node && node.folders ? node.folders[pathArr[i]] : null;
                if (!node) return null;
            }
            return node;
        }

        function switchTopFolder(folderId) {
            currentPath = [folderId];
            renderCurrentLevel();
            folderNameSpan.textContent = getDisplayName(folderId);
            updateTopFolderIcon(folderId);
            document.querySelectorAll('#dropdownMenu li').forEach(li => {
                li.classList.toggle('active', li.dataset.folder === folderId);
            });
            wrapper.classList.remove('open');
        }

        function updateTopFolderIcon(folderId) {
            const config = FOLDER_ICON_MAP[folderId] || FOLDER_ICON_MAP['default'];
            if (config.type === 'image') {
                iconI.style.display = 'none';
                iconImg.src = config.value;
                iconImg.style.display = 'inline-block';
            } else {
                iconImg.style.display = 'none';
                iconI.style.display = 'inline-block';
                iconI.className = config.value;
            }
        }

        function handleDownload(e) {
            const href = this.getAttribute('href') || '';
            if (!href || href.startsWith('javascript:')) return;
            if (href.toLowerCase().endsWith('.html')) return;
            e.preventDefault();
            let originalName = this.dataset.originalName;
            if (!originalName) originalName = href.substring(href.lastIndexOf('/') + 1);
            const baseName = getFileDisplayName(originalName);
            const now = new Date();
            const dateStr = now.getFullYear().toString().slice(-2) + (now.getMonth()+1).toString().padStart(2,'0') + now.getDate().toString().padStart(2,'0');
            const lastDot = baseName.lastIndexOf('.');
            const newName = lastDot > 0 ? baseName.slice(0,lastDot) + '-' + dateStr + baseName.slice(lastDot) : baseName + '-' + dateStr;
            const a = document.createElement('a');
            a.href = href;
            a.download = newName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        backBar.addEventListener('click', () => {
            if (currentPath.length > 1) {
                currentPath.pop();
                renderCurrentLevel();
            }
        });

        // 初始化
        buildUIContainers();
        if (folderIds.length > 0) {
            switchTopFolder(folderIds[0]);
        } else {
            contentDiv.innerHTML = '<div class="empty-folder">暂无可用文件夹</div>';
        }

        trigger.addEventListener('click', e => { e.stopPropagation(); wrapper.classList.toggle('open'); });
        dropdownMenuUl.addEventListener('click', e => {
            const li = e.target.closest('li');
            if (!li) return;
            e.stopPropagation();
            switchTopFolder(li.dataset.folder);
        });
        document.addEventListener('click', e => { if (!wrapper.contains(e.target)) wrapper.classList.remove('open'); });
        document.addEventListener('keydown', e => { if (e.key === 'Escape') wrapper.classList.remove('open'); });
    })();
</script>
</body>
</html>